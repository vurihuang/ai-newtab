# Only needed for the Node/Bun harness. The extension uses its Settings UI.
# Magpie / OpenAI-compatible mode: pnpm gateway:run
GATEWAY_BASE_URL=http://127.0.0.1:3425/v1
GATEWAY_API_KEY=
GATEWAY_MODEL=group/auto-deepseek-v4-1-flash

# Original Managed Agents mode: pnpm agent:run
ANTHROPIC_API_KEY=
# Optional: standing instructions for harness runs (same as the extension's Settings box)
HOMEPAGE_PROMPT=
